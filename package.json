{
  "name": "emberfall",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @emberfall/web build",
    "start": "pnpm --filter @emberfall/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sim": "pnpm --filter @emberfall/rules sim",
    "verify": "pnpm --filter @emberfall/server verify",
    "e2e": "pnpm --filter @emberfall/server e2e",
    "setup:agents": "pnpm --filter @emberfall/server setup:agents",
    "contract:test": "cd contracts/emberfall && cargo test --locked",
    "contract:build": "cd contracts/emberfall && cargo near build non-reproducible-wasm --locked"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.20.6"
  }
}
